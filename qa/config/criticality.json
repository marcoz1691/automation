{
  "$comment": "Mapa archivo → criterios de aceptación. El impacto de un archivo es la criticidad máxima de sus AC (sale del PRD). Primer patrón que coincide gana.",
  "prd": "requirements/landing.prd.md",
  "thresholds": { "deep": 15, "smoke": 6 },
  "smokeAcs": ["AC-01", "AC-04", "AC-08"],
  "areas": [
    { "pattern": "web/js/checkout.js", "acs": ["AC-01", "AC-02", "AC-03"] },
    { "pattern": "web/js/config.js", "acs": ["AC-01", "AC-02"] },
    { "pattern": "web/js/main.js", "acs": ["AC-01", "AC-02", "AC-03", "AC-05", "AC-06", "AC-07"] },
    { "pattern": "web/index.html", "acs": ["AC-01", "AC-03", "AC-04", "AC-05", "AC-06", "AC-07", "AC-08"] },
    { "pattern": "web/css/**", "acs": ["AC-03", "AC-06", "AC-08"] },
    { "pattern": "web/vite.config.js", "acs": ["AC-09", "AC-10"] },
    { "pattern": "web/package*.json", "acs": ["AC-09", "AC-10"] },
    { "pattern": "web/assets/**", "acs": ["AC-08"] },
    { "pattern": "qa/**", "acs": [] },
    { "pattern": "ebook/**", "acs": [] }
  ]
