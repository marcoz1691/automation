generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  dentistId    String?
  dentist      Dentist? @relation(fields: [dentistId], references: [id])
  createdAt    DateTime @default(now())
}

model Patient {
  id              String           @id @default(cuid())
  name            String
  phone           String
  email           String?
  notes           String?
  createdAt       DateTime         @default(now())
  appointments    Appointment[]
  aiConversations AiConversation[]
  waitlistEntries WaitlistEntry[]

  @@index([phone])
}

model Dentist {
  id              String           @id @default(cuid())
  name            String
  specialty       String?
  kind            String           @default("INTERNO")
  schedule        String
  active          Boolean          @default(true)
  appointments    Appointment[]
  users           User[]
  waitlistEntries WaitlistEntry[]
}

model Service {
  id              String           @id @default(cuid())
  name            String
  durationMin     Int
  price           Float?
  description     String?
  active          Boolean          @default(true)
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
}

model Appointment {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  dentistId       String
  dentist         Dentist  @relation(fields: [dentistId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  datetimeStart   DateTime
  datetimeEnd     DateTime
  status          String   @default("PENDIENTE")
  source          String   @default("WEB")
  notes           String?
  reason          String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String?
  reminderSent24h Boolean  @default(false)
  reminderSent2h  Boolean  @default(false)
  messagesLog     MessageLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([datetimeStart])
  @@index([status])
}

model MessageLog {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  channel       String
  template      String
  content       String
  sentAt        DateTime     @default(now())
  status        String       @default("MOCK")
}

model AiConversation {
  id           String   @id @default(cuid())
  patientPhone String?
  patientId    String?
  patient      Patient? @relation(fields: [patientId], references: [id])
  messagesJson String
  escalated    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClinicSettings {
  id                      String  @id @default("default")
  clinicName              String  @default("Odontoclinic")
  tagline                 String  @default("Clínica Odontológica")
  address                 String
  phone                   String
  whatsapp                String
  email                   String?
  timezone                String  @default("America/Guayaquil")
  cancellationPolicyHours Int     @default(24)
  hoursJson               String
  acceptsInsurance        Boolean @default(false)
  paymentMethods          String?
  whatsappConfig          String?
  faqJson                 String?
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  dentistId     String?
  dentist       Dentist? @relation(fields: [dentistId], references: [id])
  preferredDate String?
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())
}
